# ─────────────────────────────────────────────────────────────────────────────
# InWest App — Backend environment variables
# Copy to .env for local dev. Docker Compose sets JWT_SECRET / ENCRYPTION_KEY / DATABASE_URL
# without this file (optional backend/.env overrides server vars or seeds demo keys).
#
# MULTI-USER KEYS: Each user has their own keys in PostgreSQL (user_api_keys).
#   • Production / any user → Account → API keys in the app
#   • Dev shortcut → set provider vars below + npm run keys:import-env (demo user only)
#   • .env is NOT a shared keyring for all users — see docs/INTEGRATIONS.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/inwest

# ── Auth ─────────────────────────────────────────────────────────────────────
# Docker Compose sets JWT_SECRET automatically. Required for local dev without Docker.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_use_crypto_randomBytes_64

# ── API key encryption (required for local dev — keys in DB are encrypted with this) ─
# Docker Compose sets ENCRYPTION_KEY automatically. Must be exactly 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=CHANGE_ME_32_characters_exactly!!

# Background jobs use this user's encrypted API keys (default: demo user from seed).
# API_KEYS_OWNER_USER_ID=00000000-0000-0000-0000-000000000001

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ── Alpaca (PAPER TRADING ONLY — no live brokerage in this project) ───────────
# Paper API URL (default). Credentials: Account → API keys (per user, encrypted in DB).
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# ALPACA_ORDER_SYNC_USER_EMAIL=demo@demo.com
# ALPACA_ORDER_SYNC_USER_ID=

# ── Resend (transactional email) ─────────────────────────────────────────────
RESEND_API_KEY=your_resend_key
EMAIL_FROM=noreply@yourdomain.com

# ── Reddit bot identity (optional — OAuth keys are in DB) ────────────────────
REDDIT_USERNAME=your_reddit_username
# REDDIT_PASSWORD=
REDDIT_USER_AGENT=InwestApp/1.0 (investment-sentiment-analysis)

# ── Reddit automation ─────────────────────────────────────────────────────────
REDDIT_AUTO_FETCH=false
REDDIT_FETCH_INTERVAL=15
# REDDIT_BACKFILL_DISABLED=true

# ── Stooq historical CSV (EOD) ───────────────────────────────────────────────
# STOOQ_API_KEY=

ML_SENTIMENT_URL=http://localhost:8000
ML_TIMEOUT=30000

# ── Background scheduler ──────────────────────────────────────────────────────
SCHEDULER_ENABLED=false
AUTOMATION_ENABLED=false
PORTFOLIO_AUTO_REFRESH=false
STRATEGY_ENGINE_ENABLED=false

# ── Optional: dev import into demo user (npm run keys:import-env) ───────────
# Runtime uses per-user keys from DB. These copy into user_api_keys for the demo
# account only. Other users add keys in the app. In production, use the UI only.
#
# ALPACA_API_KEY=
# ALPACA_API_SECRET=
# ALPACA_PAPER_TRADING=true
# FINNHUB_API_KEY=
# ALPHA_VANTAGE_API_KEY=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# NEWSDATA_API_KEY=
