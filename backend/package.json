  "dependencies": {
    "@metastable/cppzst": "^2.2.2",
    "@types/cors": "^2.8.18",
    "@types/express": "^4.17.22",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/snoowrap": "^1.16.1",
    "@types/ws": "^8.18.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.29.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "pg": "^8.16.0",
    "pg-copy-streams": "^6.0.6",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.3",
