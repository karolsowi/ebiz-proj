{
  "name": "inwest-app-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc",
    "docs:api": "tsx scripts/generate-api-docs.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext ts --report-unused-disable-directives --max-warnings 0",
    "setup": "node scripts/setup-env.js",
    "env:setup": "node scripts/setup-env.js",
    "db:setup": "node scripts/setup-database.js",
    "db:migrate": "node scripts/setup-database.js migrate",
    "db:cache-user-scope": "tsx scripts/apply-api-cache-user-scoped.ts",
    "db:check": "node scripts/setup-database.js check",
    "db:sample": "node scripts/setup-database.js sample",
    "reddit:setup": "node scripts/setup-reddit-database.js",
    "reddit:check": "node scripts/setup-reddit-database.js check",
    "reddit:subreddits": "node scripts/setup-reddit-database.js subreddits",
    "ml:health": "tsx scripts/ml-health.ts",
    "sentiment:metadata": "tsx scripts/run_metadata_sentiment_batch.ts",
    "sentiment:full-backfill": "tsx scripts/sentiment_full_backfill.ts",
    "universe:import-constituents": "tsx scripts/import_index_constituents.ts",
    "earnings:sync-events": "tsx scripts/sync_earnings_events.ts",
    "earnings:scrape-yahoo": "tsx scripts/scrape_yahoo_earnings_calendar.ts",
    "earnings:scrape-yahoo-selenium": "tsx scripts/scrape_yahoo_earnings_selenium.ts",
    "earnings:scrape-yahoo-selenium-sp500": "tsx scripts/scrape_yahoo_earnings_selenium.ts --universe=sp500",
    "reddit:delete-comments-low-score": "tsx scripts/delete_reddit_comments_below_score.ts",
    "reddit:clear-comments-sentiment": "tsx scripts/clear_reddit_comments_sentiment.ts",
    "import:spy-csv": "tsx scripts/import_spy_csv.ts",
    "data:sp500-check": "tsx scripts/check-sp500-coverage.ts",
    "data:sp500-backfill": "tsx scripts/backfill-sp500-gaps.ts",
    "drizzle:generate": "drizzle-kit generate:pg",
    "drizzle:push": "drizzle-kit push:pg",
    "drizzle:studio": "drizzle-kit studio",
    "prisma:generate": "npx prisma generate",
    "prisma:push": "npx prisma db push",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:studio": "npx prisma studio",
    "prisma:seed": "tsx src/scripts/seed.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "keys:import-env": "tsx src/scripts/importApiKeysFromEnv.ts",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "promote-admin": "tsx scripts/promote-admin.ts"
